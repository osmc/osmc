+namespace
+{
+// The time zone database, with the trailing slash so a zone name can be appended.
+constexpr std::string_view ZONEINFO = "/usr/share/zoneinfo/";
+
+// Compiled zone files are a few KiB; anything far larger is not one.
+constexpr size_t MAX_ZONE_FILE_SIZE = 64 * 1024;
+
+std::string ReadZoneFile(const std::string& path)
+{
+  std::string content;
+  std::FILE* file = std::fopen(path.c_str(), "rb");
+  if (file == nullptr)
+    return content;
+
+  char buffer[4096];
+  size_t len;
+  while ((len = std::fread(buffer, 1, sizeof(buffer), file)) > 0)
+  {
+    content.append(buffer, len);
+    if (content.size() > MAX_ZONE_FILE_SIZE)
+    {
+      content.clear();
+      break;
+    }
+  }
+
+  std::fclose(file);
+  return content;
+}
+
+// systemd-escape(1) for a unit instance name: '/' becomes '-', and anything other than ASCII
+// letters, digits, ':', '_' and a non-leading '.' becomes \xNN.
+std::string EscapeUnitInstance(const std::string& value)
+{
+  std::string escaped;
+  for (size_t i = 0; i < value.size(); i++)
+  {
+    const char c = value[i];
+    if (c == '/')
+      escaped += '-';
+    else if (StringUtils::isasciialphanum(c) || c == ':' || c == '_' || (c == '.' && i > 0))
+      escaped += c;
+    else
+      escaped += StringUtils::Format("\\x{:02x}", static_cast<unsigned char>(c));
+  }
+  return escaped;
+}
+} // namespace
