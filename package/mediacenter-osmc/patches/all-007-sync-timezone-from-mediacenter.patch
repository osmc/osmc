-std::string CPosixTimezone::GetOSConfiguredTimezone()
+void CPosixTimezone::SyncSystemTimezone(const std::string& timezone)
 {
-  std::string timezoneName;
+  // OSMC: Kodi's time zone setting drives the system's. osmc-timezone@.service validates the name
+  // again and, sandboxed, points /etc/localtime at the zone and updates /etc/timezone. Only start
+  // it when the system is not already on this zone, so a normal start does not touch /etc.
+  if (timezone.empty())
+    return;
 
-  // try Slackware approach first
-  timezoneName = ReadFromLocaltime("/etc/localtime-copied-from");
+  if (!IsValidTimezone(timezone))
+  {
+    CLog::Log(LOGWARNING, "CPosixTimezone: not applying invalid time zone \"{}\" to the system",
+              timezone);
+    return;
+  }
 
-  // RHEL and maybe other distros make /etc/localtime a symlink
-  if (timezoneName.empty())
-    timezoneName = ReadFromLocaltime("/etc/localtime");
+  char target[PATH_MAX];
+  const ssize_t len = readlink("/etc/localtime", target, sizeof(target) - 1);
+  if (len != -1 && std::string_view(target, len) == std::string(ZONEINFO) + timezone)
+    return;
 
-  // now try Debian approach
-  if (timezoneName.empty())
-    timezoneName = ReadFromTimezone("/etc/timezone");
+  const std::string unit = "osmc-timezone@" + EscapeUnitInstance(timezone) + ".service";
+  if (!CUtil::Command({"/bin/systemctl", "start", unit}, true))
+    CLog::Log(LOGERROR, "CPosixTimezone: starting {} failed, see 'journalctl -u {}'", unit, unit);
+}
 
-  return timezoneName;
+bool CPosixTimezone::IsValidTimezone(const std::string& timezone)
+{
+  // Path components of ASCII letters, digits, '_', '+' and '-'. Without '.' the name cannot
+  // leave the zone database.
+  if (timezone.empty() || timezone.front() == '/' || timezone.back() == '/' ||
+      timezone.find("//") != std::string::npos)
+    return false;
+
+  for (const char c : timezone)
+  {
+    if (!StringUtils::isasciialphanum(c) && c != '_' && c != '+' && c != '-' && c != '/')
+      return false;
+  }
+
+  // zoneinfo/localtime links back to /etc/localtime
+  if (timezone == "localtime" || timezone == "posixrules")
+    return false;
+
+  // and it has to be a compiled zone file
+  std::FILE* file = std::fopen((std::string(ZONEINFO) + timezone).c_str(), "rb");
+  if (file == nullptr)
+    return false;
+
+  char magic[4];
+  const bool tzif =
+      std::fread(magic, 1, sizeof(magic), file) == sizeof(magic) && std::memcmp(magic, "TZif", 4) == 0;
+  std::fclose(file);
+  return tzif;
+}
+
+std::string CPosixTimezone::GetOSConfiguredTimezone()
+{
+  // Slackware records where its copy came from, Debian and RHEL make /etc/localtime a symlink,
+  // and Debian also keeps the name in /etc/timezone. Take the first that names a real zone.
+  for (const std::string& timezone :
+       {ReadFromLocaltime("/etc/localtime-copied-from"), ReadFromLocaltime("/etc/localtime"),
+        ReadFromTimezone("/etc/timezone")})
+  {
+    if (IsValidTimezone(timezone))
+      return timezone;
+  }
+
+  // OSMC: builds before osmc-timezone@.service left /etc/localtime as a plain copy, and could
+  // leave "etc/localtime" in /etc/timezone, so recognise the copy by its contents.
+  return FindTimezoneByContent("/etc/localtime");
 }
 
 std::string CPosixTimezone::ReadFromLocaltime(const std::string_view filename)
 {
+  // Only a symlink names a zone. A plain file is a copy of one, and its own path is not a zone
+  // name: taking the last two components of "/etc/localtime" gives "etc/localtime".
+  struct stat st;
+  if (lstat(filename.data(), &st) != 0 || !S_ISLNK(st.st_mode))
+    return "";
+
   char path[PATH_MAX];
-  if(realpath(filename.data(), path) == nullptr)
+  const ssize_t len = readlink(filename.data(), path, sizeof(path) - 1);
+  if (len == -1)
     return "";
 
-  // Read the timezone starting from the second last occurrence of /
-  std::string str = path;
-  size_t pos = str.rfind('/');
+  path[len] = '\0';
+  std::string target = path;
+
+  // On webOS /etc/localtime links to another link, so resolve the whole chain there
+  if (target.find("zoneinfo/") == std::string::npos)
+  {
+    if (realpath(filename.data(), path) == nullptr)
+      return "";
+    target = path;
+  }
+
+  // Everything after "zoneinfo/", for absolute and relative links alike. Three-level names such
+  // as America/Argentina/Buenos_Aires stay whole.
+  const size_t pos = target.find("zoneinfo/");
   if (pos == std::string::npos)
     return "";
 
-  pos = str.rfind('/', pos - 1);
-  if (pos == std::string::npos)
+  return target.substr(pos + std::strlen("zoneinfo/"));
+}
+
+std::string CPosixTimezone::FindTimezoneByContent(const std::string_view filename,
+                                                  const std::string& countryCode)
+{
+  // Match a plain copy against the zones Kodi offers. Some share their contents across countries
+  // (Europe/Oslo and Arctic/Longyearbyen), so a match must be unique, or unique within
+  // countryCode; otherwise give up rather than guess.
+  struct stat st;
+  if (lstat(filename.data(), &st) != 0 || !S_ISREG(st.st_mode) ||
+      static_cast<size_t>(st.st_size) > MAX_ZONE_FILE_SIZE)
+    return "";
+
+  const std::string localtime = ReadZoneFile(std::string(filename));
+  if (localtime.empty())
     return "";
 
-  return str.substr(pos + 1);
+  std::vector<std::string> matches;
+  std::vector<std::string> countryMatches;
+  for (const auto& [timezone, country] : m_countriesByTimezoneName)
+  {
+    const std::string path = std::string(ZONEINFO) + timezone;
+    struct stat zone;
+    if (stat(path.c_str(), &zone) != 0 || zone.st_size != st.st_size ||
+        ReadZoneFile(path) != localtime)
+      continue;
+
+    matches.push_back(timezone);
+    if (!countryCode.empty() && country == countryCode)
+      countryMatches.push_back(timezone);
+  }
+
+  if (matches.size() == 1)
+    return matches.front();
+  if (countryMatches.size() == 1)
+    return countryMatches.front();
+  return "";
 }
 
 std::string CPosixTimezone::ReadFromTimezone(const std::string_view filename)
@@ -248,6 +432,8 @@ std::string CPosixTimezone::ReadFromTimezone(const std::string_view filename)
     std::fclose(file);
   }
 
+  // fgets() keeps the newline
+  StringUtils::Trim(timezoneName);
   return timezoneName;
 }
 
