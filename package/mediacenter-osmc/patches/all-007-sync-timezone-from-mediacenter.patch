 {
    char* line = NULL;
@@ -155,7 +211,29 @@ void CPosixTimezone::OnSettingChanged(const std::shared_ptr<const CSetting>& set
 
 void CPosixTimezone::OnSettingsLoaded()
 {
-  SetTimezone(CServiceBroker::GetSettingsComponent()->GetSettings()->GetString(CSettings::SETTING_LOCALE_TIMEZONE));
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  std::string timezone = settings->GetString(CSettings::SETTING_LOCALE_TIMEZONE);
+
+  // OSMC: a stored value that is not a zone falls back to the system's zone. Earlier builds could
+  // store "etc/localtime" (a plain /etc/localtime misread as a zone name) and the walkthrough
+  // "UTC/UTC". If the system's copy matches zones in several countries, the stored country
+  // decides. Change callbacks may not fire during load, so apply the result here either way.
+  if (!IsValidTimezone(timezone))
+  {
+    std::string system = GetOSConfiguredTimezone();
+    if (system.empty())
+    {
+      const auto country =
+          m_countryByName.find(settings->GetString(CSettings::SETTING_LOCALE_TIMEZONECOUNTRY));
+      if (country != m_countryByName.end())
+        system = FindTimezoneByContent("/etc/localtime", country->second);
+    }
+
+    if (!system.empty() && settings->SetString(CSettings::SETTING_LOCALE_TIMEZONE, system))
+      timezone = system;
+  }
+
+  SetTimezone(timezone);
   CDateTime::ResetTimezoneBias();
 }
 
