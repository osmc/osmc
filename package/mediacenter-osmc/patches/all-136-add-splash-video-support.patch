+      // optionally play a one-time startup video over the start window. Dispatched
+      // onto the main loop so it does not block initialisation, and suppresses the
+      // refresh-rate mode switch so it cannot cause a signal-loss resolution change.
+      if (firstWindow != WINDOW_STARTUP_ANIM &&
+          m_eOSMCWalkthroughState == OSMC_WALKTHROUGH_NOTRUNNING)
