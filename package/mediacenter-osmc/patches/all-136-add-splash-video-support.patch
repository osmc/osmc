+  // playback so the splash never triggers a signal-loss resolution change.
+  options.preventRefreshSwitch = item.GetProperty("preventrefreshswitch").asBoolean(false);
+
   if (item.HasProperty("StartPercent"))
   {
     options.startpercent = item.GetProperty("StartPercent").asDouble();
diff --git a/xbmc/application/ApplicationStartupVideo.cpp b/xbmc/application/ApplicationStartupVideo.cpp
new file mode 100644
index 0000000000..8ad22761c9
--- /dev/null
+++ b/xbmc/application/ApplicationStartupVideo.cpp
@@ -0,0 +1,98 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "ApplicationStartupVideo.h"
+
+#include "FileItem.h"
+#include "ServiceBroker.h"
+#include "filesystem/File.h"
+#include "messaging/ApplicationMessenger.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
+#include "utils/Variant.h"
+#include "utils/log.h"
+#include "windowing/GraphicContext.h"
+#include "windowing/WinSystem.h"
+
+#include <memory>
+
+namespace
+{
+// User setting gating the startup video. Per-platform default is shipped in
+// the settings definition, not decided here.
+constexpr const char* SETTING_STARTUPVIDEO = "lookandfeel.startupvideo";
+
+// Stock clip and an optional OEM override (OEM takes precedence when present).
+// A "_25" / "_30" suffix selects the framerate matching the display.
+// The OEM override deliberately uses a distinct "_oem" name rather than
+// ply-lite's "<file>.oem" suffix, so Kodi still detects the container/player
+// by extension (a ".oem" suffix would not be recognised as video).
+constexpr const char* STOCK_CLIP = "/usr/share/osmc/splash_osmc";
+constexpr const char* OEM_CLIP = "/usr/share/osmc/splash_oem";
+constexpr const char* CLIP_EXT = ".mp4";
+
+// Below this refresh rate we treat the display as the 50Hz family (25fps clip);
+// at or above it, the 60Hz family (30fps clip). 50.00 and 59.94/60.00 land on
+// the correct sides.
+constexpr float REFRESH_SPLIT_HZ = 55.0f;
+} // namespace
+
+std::string CStartupVideo::ResolveClip()
+{
+  const auto* winSystem = CServiceBroker::GetWinSystem();
+  if (!winSystem)
+    return {};
+
+  const float refreshRate = winSystem->GetGfxContext().GetResInfo().fRefreshRate;
+  const std::string suffix = (refreshRate < REFRESH_SPLIT_HZ) ? "_25" : "_30";
+
+  const std::string oem = std::string(OEM_CLIP) + suffix + CLIP_EXT;
+  if (XFILE::CFile::Exists(oem))
+  {
+    CLog::Log(LOGINFO, "CStartupVideo: using OEM startup clip {}", oem);
+    return oem;
+  }
+
+  const std::string stock = std::string(STOCK_CLIP) + suffix + CLIP_EXT;
+  if (XFILE::CFile::Exists(stock))
+  {
+    CLog::Log(LOGINFO, "CStartupVideo: using startup clip {}", stock);
+    return stock;
+  }
+
+  return {};
+}
+
+bool CStartupVideo::PlayIfEnabled()
+{
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings || !settings->GetBool(SETTING_STARTUPVIDEO))
+    return false;
+
+  const std::string clip = ResolveClip();
+  if (clip.empty())
+  {
+    CLog::Log(LOGDEBUG, "CStartupVideo: enabled but no matching clip found, skipping");
+    return false;
+  }
+
+  // Play once, fullscreen. "preventrefreshswitch" tells CApplication::PlayFile to
+  // skip the adjust-refresh-rate mode switch for THIS playback only, so we never
+  // modify (or have to restore) the global setting and never cause a signal-loss
+  // mode change for the clip.
+  auto item = std::make_unique<CFileItem>(clip, false);
+  item->SetProperty("preventrefreshswitch", true);
+
+  CLog::Log(LOGINFO, "CStartupVideo: playing startup video {}", clip);
+
+  // Dispatch onto the main loop so playback does not block initialisation. The
+  // handler takes ownership of the CFileItem (param2 == 0 -> single item path).
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_PLAY, 0, 0,
+                                             static_cast<void*>(item.release()));
+  return true;
+}
diff --git a/xbmc/application/ApplicationStartupVideo.h b/xbmc/application/ApplicationStartupVideo.h
new file mode 100644
index 0000000000..fbb4af59ed
--- /dev/null
+++ b/xbmc/application/ApplicationStartupVideo.h
@@ -0,0 +1,41 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <string>
+
+/*!
+ * \brief One-time startup video ("splash") helper.
+ *
+ * Plays a short clip once when Kodi starts, gated by a user setting.
+ *
+ * Two fixed-framerate clips (25fps / 30fps) are shipped so the correct one can
+ * be matched to a 50Hz or 60Hz display WITHOUT performing a resolution/refresh
+ * change. The mode switch that playback would normally trigger is suppressed for
+ * this one clip via CPlayerOptions::preventRefreshSwitch, so the global
+ * "Adjust display refresh rate" setting is never modified.
+ */
+class CStartupVideo
+{
+public:
+  /*!
+   * \brief Play the startup video if the user setting is enabled and a clip
+   *        matching the current display refresh rate exists.
+   * \return true if playback was dispatched, false otherwise.
+   */
+  static bool PlayIfEnabled();
+
+private:
+  /*!
+   * \brief Resolve the clip to play for the current display refresh rate.
+   *        An OEM clip overrides the stock clip when present.
+   * \return path to an existing clip, or an empty string if none was found.
+   */
+  static std::string ResolveClip();
+};
