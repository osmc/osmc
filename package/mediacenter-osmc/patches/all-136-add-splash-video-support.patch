 xbmc/application/Application.cpp             | 12 +++
 xbmc/application/ApplicationStartupVideo.cpp | 98 ++++++++++++++++++++
 xbmc/application/ApplicationStartupVideo.h   | 41 ++++++++
 xbmc/application/CMakeLists.txt              |  2 +
 xbmc/cores/IPlayer.h                         |  2 +
 xbmc/cores/VideoPlayer/VideoPlayer.cpp       | 18 ++++
 7 files changed, 178 insertions(+)
 create mode 100644 xbmc/application/ApplicationStartupVideo.cpp
 create mode 100644 xbmc/application/ApplicationStartupVideo.h

