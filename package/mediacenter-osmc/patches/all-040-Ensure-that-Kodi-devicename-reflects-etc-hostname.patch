 #include <utility>
 
 #ifdef TARGET_LINUX
@@ -87,6 +90,70 @@ using namespace UPNP;
 
 using KODI::MESSAGING::HELPERS::DialogResponse;
 
+#ifdef TARGET_LINUX
+namespace
+{
+// OSMC: the device name is a free-form friendly name (AirPlay, UPnP), but the hostname must be one
+// DNS label. Keep ASCII letters and digits, turn spaces and separators into a single '-', drop
+// everything else, and fall back to "osmc" if nothing is left: "Sam's Vero (Lounge)" becomes
+// "Sams-Vero-Lounge".
+std::string HostnameFromDeviceName(const std::string& deviceName)
+{
+  std::string hostname;
+  bool separator = false;
+  for (const char c : deviceName)
+  {
+    if (StringUtils::isasciialphanum(c))
+    {
+      if (separator && !hostname.empty())
+        hostname += '-';
+      hostname += c;
+      separator = false;
+    }
+    else if (c != '\0' && std::strchr(" \t-_.,/:;+&|", c) != nullptr)
+      separator = true;
+  }
+
+  // a label is at most 63 characters and must not end in '-'
+  if (hostname.size() > 63)
+    hostname.resize(63);
+  while (!hostname.empty() && hostname.back() == '-')
+    hostname.pop_back();
+
+  return hostname.empty() ? "osmc" : hostname;
+}
+
+// OSMC: the system hostname follows the device name. osmc-hostname@.service validates the name
+// again and hands it to systemd-hostnamed, which writes /etc/hostname and sets the running
+// hostname. Only start it when /etc/hostname differs.
+void SyncSystemHostname(const std::string& deviceName)
+{
+  const std::string hostname = HostnameFromDeviceName(deviceName);
+
+  std::string current;
+  std::FILE* file = std::fopen("/etc/hostname", "r");
+  if (file != nullptr)
+  {
+    char line[256];
+    if (std::fgets(line, sizeof(line), file) != nullptr)
+      current = line;
+    std::fclose(file);
+  }
+  StringUtils::Trim(current);
+  if (current == hostname)
+    return;
+
+  // only letters, digits and '-' remain, and '-' is the one that systemd-escape(1) changes
+  std::string instance = hostname;
+  StringUtils::Replace(instance, "-", "\\x2d");
+
+  const std::string unit = "osmc-hostname@" + instance + ".service";
+  if (!CUtil::Command({"/bin/systemctl", "start", unit}, true))
+    CLog::Log(LOGERROR, "CNetworkServices: starting {} failed, see 'journalctl -u {}'", unit, unit);
+}
+} // namespace
+#endif
+
