# Keep /run/osmc-password-check/default present while the osmc account has the
# default password, for the SSH login warning in
# /etc/profile.d/105-check-ssh-password.sh. Runs at boot, and through
# osmc-password-check.path whenever /etc/shadow changes, so the warning stops
# as soon as the password is changed.

[Unit]
Description=Check whether osmc still has the default password

[Service]
Type=oneshot
ExecStart=/usr/lib/osmc/osmc-password-check
UMask=0022

# Reads /etc/shadow, which root owns, so no capabilities are needed. Writes
# only its flag; the directory outlives the oneshot so logins can see it.
ProtectSystem=strict
RuntimeDirectory=osmc-password-check
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
CapabilityBoundingSet=
# 'none' needs systemd 249; bullseye has 247
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
