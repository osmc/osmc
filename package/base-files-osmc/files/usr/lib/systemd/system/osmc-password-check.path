# Recheck the osmc password whenever /etc/shadow changes. passwd, chpasswd and
# usermod replace the file with a rename, which removes the watched inode and
# so triggers a change.

[Unit]
Description=Recheck the osmc password when /etc/shadow changes

[Path]
PathChanged=/etc/shadow
Unit=osmc-password-check.service

[Install]
WantedBy=paths.target
