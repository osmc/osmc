#!/bin/bash

if [ "$1" = "remove" ]; then
	systemctl disable osmc-id-generator.service osmc-report-stats.timer
	systemctl stop osmc-id-generator.service osmc-report-stats.timer
	systemctl disable osmc-password-check.service osmc-password-check.path
	systemctl stop osmc-password-check.service osmc-password-check.path
	exit 0
fi

