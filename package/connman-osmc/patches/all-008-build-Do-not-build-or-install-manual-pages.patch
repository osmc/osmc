From c12bb3357d792f6bbf1f500bee681028f0345758 Mon Sep 17 00:00:00 2001
From: Sam Nazarko <email@samnazarko.co.uk>
Date: Tue, 5 Dec 2017 18:25:42 +0000
Subject: [PATCH] build: Do not build or install manual pages

OSMC images do not ship manual pages, so skip generating and installing
them.

Signed-off-by: Sam Nazarko <email@samnazarko.co.uk>
---
 Makefile.am | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/Makefile.am b/Makefile.am
index 1e44314f..b7d61c7b 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -480,11 +480,6 @@ EXTRA_DIST += src/main.conf \
 		src/eduroam.config \
 		scripts/connman_resolvconf.conf.in
 
-MANUAL_PAGES += doc/connmanctl.1 doc/connman.conf.5 \
-		doc/connman-service.config.5 doc/connman-vpn.conf.5 \
-		doc/connman-vpn-provider.config.5 \
-		doc/connman.8 doc/connman-vpn.8
-
 nodist_man_MANS = $(MANUAL_PAGES)
 
 pkgconfigdir = $(libdir)/pkgconfig
-- 
2.34.1

