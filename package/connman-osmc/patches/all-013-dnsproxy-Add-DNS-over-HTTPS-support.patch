+/* A root NS query checks a new configuration without leaking names */
+static const unsigned char doh_probe_query[] = {
+	0x00, 0x00, 0x01, 0x00, 0x00, 0x01, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x01,
+};
