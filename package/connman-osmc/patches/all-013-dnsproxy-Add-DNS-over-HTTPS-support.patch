+static bool doh_valid_servers(char **servers)
+{
+	if (servers && g_strv_length(servers) > DOH_MAX_SERVERS)
+		return false;
+
+	for (int i = 0; servers && servers[i]; i++) {
+		if (!__connman_doh_url_is_valid(servers[i]))
+			return false;
+	}
+
+	return true;
+}
