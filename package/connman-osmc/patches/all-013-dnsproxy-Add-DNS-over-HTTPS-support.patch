+/*
+ * Hand the request to the next DoH server not yet tried for it. Returns
+ * -EBUSY when the remaining servers are only overloaded and -ENODEV when
+ * none of them can be used.
+ */
+static int doh_forward(struct request_data *req)
+{
+	const size_t offset = protocol_offset(req->protocol);
+	GSList *servers = doh_current_servers(), *list;
+	unsigned int index = 0;
+	bool sent = false, busy = false;
+
+	for (list = servers; list && !sent; list = list->next, index++) {
+		struct doh_server *server = list->data;
+		int err;
+
+		if (index < req->doh_attempts)
+			continue;
+
+		req->doh_attempts = index + 1;
+
+		if (doh_mode != DOH_MODE_STRICT &&
+				!__connman_doh_server_is_available(server))
+			continue;
+
+		err = __connman_doh_send(server,
+				(unsigned char *) req->request + offset,
+				req->request_len - offset, doh_reply,
+				GUINT_TO_POINTER(req->doh_serial));
+		if (err == -EBUSY)
+			busy = true;
+		if (err < 0)
+			continue;
+
+		debug("req %p %s via %s", req, (char *) req->name,
+					__connman_doh_server_get_url(server));
+		sent = true;
+	}
+
+	g_slist_free(servers);
+
+	if (sent)
+		return 0;
+
+	return busy ? -EBUSY : -ENODEV;
+}
+
+static void doh_servfail(struct request_data *req)
+{
+	struct domain_hdr *hdr = (void *) ((char *) req->request +
+					protocol_offset(req->protocol));
+
+	hdr->id = req->srcid;
+
+	if (req->protocol == IPPROTO_UDP) {
+		int sk = get_req_udp_socket(req);
+
+		if (sk >= 0)
+			send_response(sk, req->request, req->request_len,
+					&req->sa, req->sa_len, IPPROTO_UDP);
+	} else {
+		send_response(req->client_sk, req->request, req->request_len,
+						NULL, 0, IPPROTO_TCP);
+	}
+
+	request_list = g_slist_remove(request_list, req);
+	destroy_request_data(req);
+}
+
+/* Forward the request in plain text, or fail it in strict mode */
+static void doh_fallback(struct request_data *req)
+{
+	bool sent = false;
+
+	req->doh = false;
+	req->numserv = 0;
+	req->numresp = 0;
+
+	if (doh_mode != DOH_MODE_STRICT) {
+		for (GSList *list = server_list; list; list = list->next) {
+			struct server_data *data = list->data;
+			int err;
+
+			if (data->protocol != IPPROTO_UDP || !data->enabled)
+				continue;
+
+			/* Sent once the TCP connection is established */
+			if (req->protocol == IPPROTO_TCP) {
+				if (create_server(data->index, NULL,
+						data->server, IPPROTO_TCP))
+					sent = true;
+				continue;
+			}
+
+			if (!data->channel && server_create_socket(data) < 0)
+				continue;
+
+			err = ns_resolv(data, req, req->request, req->name);
+			if (err > 0) {
+				/* answered from the cache */
+				request_list = g_slist_remove(request_list,
+									req);
+				destroy_request_data(req);
+				return;
+			}
+
+			if (err == 0)
+				sent = true;
+		}
+	}
+
+	if (!sent) {
+		debug("req %p %s failed", req, (char *) req->name);
+		doh_servfail(req);
+		return;
+	}
+
+	debug("req %p %s falls back to plain DNS", req, (char *) req->name);
+
+	if (req->timeout > 0)
+		g_source_remove(req->timeout);
+
+	req->timeout = g_timeout_add_seconds(
+				req->protocol == IPPROTO_TCP ? 30 : 5,
+				request_timeout, req);
+}
+
+/*
+ * Send the request to the next DoH server. Overloaded servers fail only
+ * this request; unusable ones make it fall back to plain DNS, or fail
+ * in strict mode.
+ */
+static void doh_retry(struct request_data *req)
+{
+	int err = doh_forward(req);
+
+	if (err == 0)
+		return;
+
+	if (err == -EBUSY) {
+		req->doh = false;
+		doh_servfail(req);
+		return;
+	}
+
+	doh_report(DOH_STATE_UNAVAILABLE);
+	doh_fallback(req);
+}
+
+/* Takes over a request that is already on the request list */
+static void doh_dispatch(struct request_data *req)
+{
+	req->doh = true;
+	req->doh_attempts = 0;
+	req->numserv = 1;
+
+	if (++doh_serial == 0)
+		doh_serial = 1;
+	req->doh_serial = doh_serial;
+
+	doh_retry(req);
+}
+
+static size_t dns_question_end(const unsigned char *msg, size_t len)
+{
+	size_t pos = DNS_HEADER_SIZE;
+
+	while (pos < len && msg[pos]) {
+		if ((msg[pos] & NS_CMPRSFLGS) == NS_CMPRSFLGS) {
+			pos += 1;
+			break;
+		}
+
+		pos += msg[pos] + 1;
+	}
+
+	pos += 1 + DNS_QTYPE_QCLASS_SIZE;
+
+	return pos <= len ? pos : 0;
+}
+
+/* Largest UDP response the client accepts (RFC 6891) */
+static size_t request_udp_size(const struct request_data *req)
+{
+	const unsigned char *msg = req->request;
+	const struct domain_hdr *hdr = req->request;
+	size_t pos = dns_question_end(msg, req->request_len);
+	size_t size;
+
+	if (!pos || !hdr->arcount || pos + 11 > req->request_len ||
+			msg[pos] != 0 || msg[pos + 1] != 0 ||
+			msg[pos + 2] != ns_t_opt)
+		return 512;
+
+	size = msg[pos + 3] << 8 | msg[pos + 4];
+
+	return MAX(size, 512);
+}
+
+static void doh_deliver(struct request_data *req, const unsigned char *reply,
+								size_t len)
+{
+	const size_t offset = protocol_offset(req->protocol);
+	g_autofree char *buf = g_malloc(offset + len);
+
+	if (offset) {
+		const uint16_t msg_len = htons(len);
+
+		memcpy(buf, &msg_len, sizeof(msg_len));
+	}
+	memcpy(buf + offset, reply, len);
+
+	req->numresp++;
+
+	if (req->protocol == IPPROTO_UDP && len > request_udp_size(req)) {
+		struct domain_hdr *hdr = (void *) buf;
+		size_t question = dns_question_end(reply, len);
+		int sk = get_req_udp_socket(req);
+
+		/* Make the client retry over TCP */
+		cache_update(IPPROTO_UDP, (unsigned char *) buf, len);
+
+		hdr->id = req->srcid;
+		hdr->tc = 1;
+		hdr->ancount = 0;
+		hdr->nscount = 0;
+		hdr->arcount = 0;
+
+		if (question && sk >= 0 && sendto(sk, buf, question,
+				MSG_NOSIGNAL, &req->sa, req->sa_len) < 0)
+			debug("Cannot send truncated reply: %s",
+							strerror(errno));
+	} else {
+		forward_dns_reply(buf, offset + len, req->protocol, req);
+	}
+
+	request_list = g_slist_remove(request_list, req);
+	destroy_request_data(req);
+}
+
+static void doh_reply(int err, const unsigned char *reply, size_t len,
+							void *user_data)
+{
+	const unsigned int serial = GPOINTER_TO_UINT(user_data);
+	struct request_data *req = NULL;
+
+	for (GSList *list = request_list; list; list = list->next) {
+		struct request_data *data = list->data;
+
+		if (data->doh && data->doh_serial == serial) {
+			req = data;
+			break;
+		}
+	}
+
+	/* Timed out or answered already */
+	if (!req)
+		return;
+
+	if (err == 0 && !reply_matches_request(req, reply, len,
+							IPPROTO_UDP))
+		err = -EBADMSG;
+
+	if (err < 0) {
+		debug("req %p %s failed: %s", req, (char *) req->name,
+							strerror(-err));
+		doh_retry(req);
+		return;
+	}
+
+	doh_report(DOH_STATE_ACTIVE);
+	doh_deliver(req, reply, len);
+}
