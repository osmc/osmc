+static void doh_load(void)
+{
+	GKeyFile *keyfile;
+	char **servers;
+	char *str;
+
+	if (!string2doh_mode(connman_setting_get_string("DNSOverHTTPS"),
+								&doh_mode))
+		doh_mode = DOH_MODE_OFF;
+
+	keyfile = __connman_storage_load_global();
+	if (!keyfile)
+		return;
+
+	str = g_key_file_get_string(keyfile, "global", "DNSOverHTTPS", NULL);
+	if (str && string2doh_mode(str, &doh_mode))
+		doh_mode_stored = true;
+	else if (str)
+		connman_warn("Invalid stored DNSOverHTTPS mode %s", str);
+	g_free(str);
+
+	servers = g_key_file_get_string_list(keyfile, "global",
+					"DNSOverHTTPSServers", NULL, NULL);
+	if (doh_valid_servers(servers))
+		doh_user_servers = servers;
+	else
+		g_strfreev(servers);
+
+	g_key_file_free(keyfile);
