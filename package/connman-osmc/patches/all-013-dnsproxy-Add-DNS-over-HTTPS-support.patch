+	if (!dnsproxy_running)
+		return -EOPNOTSUPP;
+
+	if (!string2doh_mode(mode, &new_mode) || !doh_valid_servers(servers))
+		return -EINVAL;
+
+	doh_mode = new_mode;
+
+	g_strfreev(doh_user_servers);
+	doh_user_servers = g_strdupv(servers);
+
+	doh_apply();
+
+	return 0;
+}
