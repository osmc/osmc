From ebe9a29b1d0191faebacf813d6b091ee57acfcf5 Mon Sep 17 00:00:00 2001
From: Sam Nazarko <email@samnazarko.co.uk>
Date: Fri, 8 Dec 2017 17:26:22 +0000
Subject: [PATCH] build: Do not install the resolv.conf tmpfiles.d snippet

Upstream installs connman_resolvconf.conf for systemd-tmpfiles, which
creates /etc/resolv.conf as a symlink to /run/connman/resolv.conf when
the file is missing (OSMC image builds remove it). On OSMC ConnMan
writes /etc/resolv.conf directly (see the ResolvConf default), so the
symlink must not be created.

Signed-off-by: Sam Nazarko <email@samnazarko.co.uk>
---
 Makefile.am | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/Makefile.am b/Makefile.am
index b7d61c7b..2d93b958 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -76,9 +76,6 @@ if SYSTEMD
 systemdunitdir = @SYSTEMD_UNITDIR@
 systemdunit_DATA = src/connman.service src/connman-wait-online.service
 
-tmpfilesdir = @SYSTEMD_TMPFILESDIR@
-nodist_tmpfiles_DATA = scripts/connman_resolvconf.conf
-
 if VPN
 systemdunit_DATA += vpn/connman-vpn.service
 endif
-- 
2.34.1

